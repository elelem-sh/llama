#!/bin/sh

set -eu
[ -n "${DEBUG:-}" ] && set -x

prefix=$1
shaderc_v2026_4=b64fd42c4a2a9d501c47aca5d3571f7673a5e9cc
vulkan_headers_1_4_357=e3b1eec08173d6b825cd3ac88c885a63b621504a

checkout() {
  git init -q "$2"
  git -C "$2" fetch -q --depth 1 "$1" "$3"
  git -C "$2" checkout -q FETCH_HEAD
}

src=$(mktemp -d)

checkout https://github.com/KhronosGroup/Vulkan-Headers "$src/headers" "$vulkan_headers_1_4_357"
cmake -S "$src/headers" -B "$src/headers/build" -DCMAKE_INSTALL_PREFIX="$prefix" -DVULKAN_HEADERS_ENABLE_MODULE=OFF
cmake --install "$src/headers/build"

checkout https://github.com/google/shaderc "$src/shaderc" "$shaderc_v2026_4"
(cd "$src/shaderc" && python3 utils/git-sync-deps)
cmake -S "$src/shaderc" -B "$src/shaderc/build" -DCMAKE_BUILD_TYPE=Release \
  -DSHADERC_SKIP_TESTS=ON -DSHADERC_SKIP_EXAMPLES=ON -DSHADERC_SKIP_COPYRIGHT_CHECK=ON
cmake --build "$src/shaderc/build" --target glslc_exe --parallel "$(nproc)"
install -D "$src/shaderc/build/glslc/glslc" "$prefix/bin/glslc"

rm -rf "$src"
