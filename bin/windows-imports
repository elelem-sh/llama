#!/bin/sh

set -eu
[ -n "${DEBUG:-}" ] && set -x

native=$1
part_of_windows='^(KERNEL32|ADVAPI32|WS2_32|api-ms-win-crt-[a-z0-9-]+)\.dll$'
shipped=$(ls "$native")
strays=0

for library in "$native"/*; do
  headers=$(objdump -p "$library")
  needed=$(echo "$headers" | awk '/DLL Name:/ { print $3 }')
  foreign=$(echo "$needed" | grep -v -i -E "$part_of_windows" | grep -v -i -x -F "$shipped" || true)
  loaded_on_demand=$(echo "$headers" | awk '/Delay Import Directory/ { print $3 $4 }' | tr -d 0)

  echo "$library:" $needed
  [ -n "$needed" ] || { echo "$library names no DLL it needs: is it a DLL?" >&2; strays=1; }
  [ -z "$foreign" ] || { echo "$library needs a DLL outside Windows and the gem:" $foreign >&2; strays=1; }
  [ -z "$loaded_on_demand" ] || { echo "$library loads DLLs on demand, which this check does not read" >&2; strays=1; }
done

exit $strays
