#!/usr/bin/env ruby
# frozen_string_literal: true

require "elelem/llama"

class LoadedModules
  V = Fiddle::TYPE_VOIDP
  I = Fiddle::TYPE_INT
  LONGEST_PATH = 32_768
  WIDE = 2

  def initialize(kernel32: Fiddle.dlopen("kernel32"))
    @handle = Fiddle::Function.new(kernel32["GetModuleHandleW"], [V], V)
    @file_name = Fiddle::Function.new(kernel32["GetModuleFileNameW"], [V, V, I], I)
  end

  def path_of(name)
    handle = @handle.call(wide(name))
    return if handle.null?

    buffer = Fiddle::Pointer.malloc(LONGEST_PATH * WIDE, Fiddle::RUBY_FREE)
    length = @file_name.call(handle, buffer, LONGEST_PATH)
    path_in(buffer[0, length * WIDE])
  end

  private

  def wide(text) = "#{text}\0".encode(Encoding::UTF_16LE)

  def path_in(wide_text) = wide_text.force_encoding(Encoding::UTF_16LE).encode(Encoding::UTF_8).tr("\\", "/")
end

def cpu_library_from_the_gem(native, modules: LoadedModules.new)
  loaded = Dir.children(native).grep(/\Aggml-cpu-/).filter_map { modules.path_of(it) }
  strays = loaded.reject { File.dirname(it).casecmp?(native) }

  abort "no CPU library in #{native} is loaded" if loaded.empty?
  abort "CPU libraries loaded from outside #{native}: #{strays.join(", ")}" unless strays.empty?
  puts "cpu library: #{loaded.join(", ")}"
end

def memory_budget_within_the_host(memory)
  budget = memory.budget
  total = memory.total

  within = budget.positive? && budget <= total.to_i
  abort "memory budget #{budget} is not within the #{total.inspect} bytes installed" unless within
  puts "memory budget: #{budget} of #{total} bytes"
end

Elelem::Llama::Provider.new(model: ARGV.fetch(0), n_ctx: 256, max_tokens: 8)

cpu_library_from_the_gem(Elelem::Llama::Provider::NATIVE)
memory_budget_within_the_host(Elelem::Llama::HostMemory.detect)
