#!/bin/sh

set -eu
[ -n "${DEBUG:-}" ] && set -x

fail() {
  echo "$1" >&2
  exit 1
}

devices=$(ruby -relelem/llama -rjson -e 'puts JSON.generate(Elelem::Llama::Provider.devices.map(&:to_h))' | tr -d '\r')
echo "devices: $devices"
echo "$devices" | grep -q '"type":"cpu"' || fail "the shim lists no processor among its devices"

chosen=$(ruby -relelem/llama -e 'puts Elelem::Llama::ModelChoice.for_this_machine' | tr -d '\r')
echo "$chosen"

expect() {
  echo "$chosen" | sed -n "$1p" | grep -Eqx "$2" || fail "line $1 of the choice is not $2"
}

expect 1 'name=[a-z0-9.-]+'
expect 2 'url=https://huggingface\.co/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/resolve/[0-9a-f]{40}/[A-Za-z0-9._-]+\.gguf'
expect 3 'file=[A-Za-z0-9._-]+\.gguf'
expect 4 'bytes=[0-9]+'
expect 5 'sha256=[0-9a-f]{64}'
[ "$(echo "$chosen" | wc -l)" -eq 5 ] || fail "the choice is not five lines"
