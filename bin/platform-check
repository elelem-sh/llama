#!/bin/sh

set -eu
[ -n "${DEBUG:-}" ] && set -x

cd "$(dirname "$0")/.."

model=$1
expected=${2:-cpu}
gem=${3:-}

if [ -z "$gem" ]; then
  rm -f elelem-llama-*.gem
  gem build elelem-llama.gemspec
  gem=$(ls ./elelem-llama-*.gem)
fi
gem install --no-document "$gem"

if [ -n "${3:-}" ]; then
  ruby -e '
    spec = Gem::Specification.find_by_name("elelem-llama")
    abort "#{spec.full_name} compiled #{spec.extensions.join(", ")}" unless spec.extensions.empty?
    abort "RubyGems here would not pick #{spec.full_name}" unless Gem::Platform.match_gem?(spec.platform, spec.name)
  '
fi

dir=$(ruby -e 'print Gem::Specification.find_by_name("elelem-llama").gem_dir')
native="$dir/ext/elelem/llama/native"

case $(uname -m) in
  x86_64) host_simd=vfmadd ;;
  aarch64 | arm64) host_simd=sdot ;;
  *) host_simd= ;;
esac
uses_host_simd() {
  for cpu_library in "$native"/libggml-cpu*; do
    if objdump -d "$cpu_library" | grep -q "$host_simd"; then return 0; fi
  done
  return 1
}
if [ -n "$host_simd" ] && ! uses_host_simd; then
  echo "no CPU library in $native has $host_simd instructions" >&2
  exit 1
fi

elelem-llama --help >/dev/null

ELELEM_KV_CACHE_TYPE=f16 ruby -e '
  require "elelem/llama"
  backend = Elelem::Llama::Provider.backend
  abort "backend #{backend}, expected #{ARGV[1]}" unless backend == ARGV[1]
  said = []
  Elelem::Llama::Provider.new(model: ARGV[0], n_ctx: 256, max_tokens: 8)
    .fetch([{ role: "user", content: "hi" }]) { |event| said << event[:text] if event[:type] == "saying" }
  reply = said.join
  abort "no reply: #{reply.inspect}" if reply.empty? || reply.start_with?("[")
  puts "reply: #{reply}"
  dyld = Fiddle::Handle::DEFAULT
  images = if File.readable?("/proc/self/maps")
    File.readlines("/proc/self/maps")
  elsif dyld.sym_defined?("_dyld_image_count")
    name = Fiddle::Function.new(dyld["_dyld_get_image_name"], [Fiddle::TYPE_INT], Fiddle::TYPE_VOIDP)
    Fiddle::Function.new(dyld["_dyld_image_count"], [], Fiddle::TYPE_INT).call.times.map { name.call(it).to_s }
  else
    []
  end
  loaded = images.filter_map { it[/\S*libggml-cpu\S*/] }
  puts "cpu library: #{loaded.first}" unless loaded.empty?
' "$model" "$expected"
