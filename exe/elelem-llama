#!/usr/bin/env ruby
# frozen_string_literal: true

Signal.trap("INT") { exit 1 }

if ARGV.first == "--pull"
  require "elelem/llama/pull"

  begin
    Elelem::Llama::Pull.new(ARGV.drop(1)).run
  rescue StandardError => e
    abort "elelem: #{e.message}"
  end
  exit
end

require "elelem/cli"

Elelem::CLI.new(ARGV, provider: "llama").run
